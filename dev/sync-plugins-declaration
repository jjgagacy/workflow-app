#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
echo "Syncing plugin declarations from monie-plugins to api/plugins-declaration..."
cd "${PROJECT_ROOT}/monie-plugins"
for plugin in */; do
  if [ -d "${plugin}dist" ]; then
    rsync -avmu \
      --include='*/' \
      --include='*.yaml' \
      --include='_assets/' \
      --include='_assets/**' \
      --exclude='*' \
      --prune-empty-dirs \
      --update \
      "${plugin}dist/" "../api/plugins-declaration/${plugin}"
  fi
done
